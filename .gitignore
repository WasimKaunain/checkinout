# Ignore database dumps
*.sql
*.dump

# Ignore environment files (if storing DB credentials here)
.env
.env.local
venv/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore logs
*.log

# Ignore backup files
*~
*.bak

# Ignore Python bytecode (if using Python)
__pycache__/
*.py[cod]

# Ignore VSCode settings (optional)
.vscode/

#ignore pdf files
*.pdf

# Ignore DB Schema files
/Db Schema
/docs
/sql_scripts/insert_data.sql
/sql_scripts/queries.sql
/Material

